# SourceWise Frontend Environment Variables (Vercel)
# In Vercel Project Settings > Environment Variables:

# URL of your deployed Node API service (e.g. https://api.yourdomain.com or https://your-node-api.vercel.app)
VITE_API_URL=http://localhost:4000

# URL of your deployed Python AI service (e.g. https://ai.yourdomain.com or https://your-python-ai.railway.app)
VITE_AI_URL=http://localhost:8000

# (Optional) Google OAuth URL if Google Login is configured
VITE_GOOGLE_AUTH_URL=
