# SourceWise V2.5 Environment Variables

# JWT Secret (required)
JWT_SECRET=your-secret-key-here

# Supabase (required)
# SERVICE_ROLE_KEY is REQUIRED in production — RLS denies direct anon-key
# access (see sourcewise-backend/node-api/fix_rls.sql).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Observability
LOG_LEVEL=info

# Python AI Service
PYTHON_AI_URL=http://localhost:8000

# Shared secret between node-api and python-ai (X-Internal-Key).
# Leave empty for plain local dev; SET IT in docker/production.
INTERNAL_API_KEY=

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# LLM Provider: "gemini" | "grok"
LLM_PROVIDER=gemini

# Gemini API (Google AI Studio - get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Grok API (xAI - get key at https://console.x.ai/) - optional fallback
GROK_API_KEY=your-grok-api-key
GROK_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

# ── Study Organizer (v13) ────────────────────────────────────────────────
# 32-byte base64 key for OAuth token encryption. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Run hourly auto-replan evaluator in dev
ENABLE_REPLAN_CRON=false

# ── Google Calendar OAuth (https://console.cloud.google.com → Calendar API) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/calendar/callback
