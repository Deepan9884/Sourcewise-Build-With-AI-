# Server
PORT=4000
NODE_ENV=development

# Supabase Configuration
# SERVICE_ROLE_KEY is REQUIRED in production: RLS denies direct anon-key
# access (see fix_rls.sql) and the server refuses to start without it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secrets (Change these in production!)
JWT_SECRET=your_super_secret_jwt_key_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Python AI Service
PYTHON_AI_URL=http://localhost:8000

# Shared secret forwarded to the Python AI service as X-Internal-Key.
# Leave empty for plain local dev; SET IT in docker/production so :8000
# rejects unauthenticated callers.
INTERNAL_API_KEY=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# ── LLM provider labels (mirror python-ai; used for token-usage logging) ─────
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash
GROK_MODEL=grok-beta

# ── Study Organizer (v13) ────────────────────────────────────────────────
# 32-byte base64 key for AES-256-GCM (Google OAuth token storage).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Set to 'true' in dev to run the hourly auto-replan evaluator locally.
ENABLE_REPLAN_CRON=false

# ── Google Calendar OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/calendar/callback

