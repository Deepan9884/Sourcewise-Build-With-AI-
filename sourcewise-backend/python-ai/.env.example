# ── LLM Provider Selection ──────────────────────────────────────────────────
# Options: "gemini" | "grok"
LLM_PROVIDER=gemini

# ── Gemini API (Google AI Studio - get key at https://aistudio.google.com/app/apikey) ──────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ── Grok API (xAI - get key at https://console.x.ai/) — optional fallback ────────────────
GROK_API_KEY=your-grok-api-key
GROK_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

# ── ChromaDB (local vector DB — stored on disk) ──────────────────────────────
# NOTE: env var is CHROMA_PERSIST_DIR to match docker-compose.yml
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=sourcewise

# ── Embedding Model (HuggingFace, runs locally) ──────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── RAG Settings ─────────────────────────────────────────────────────────────
TOP_K_CHUNKS=6
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ── RAG Quality Settings ─────────────────────────────────────────────────────
QUERY_EXPANSION_ENABLED=true
MIN_RELEVANCE_THRESHOLD=0.25
RERANK_TOP_K=8

# ── Token Reduction / Budgeting (limits tokens sent to Gemini/Grok) ──────────
MAX_CONTEXT_CHUNKS=8
MAX_CHUNK_TOKENS=600
MAX_HISTORY_TURNS=8
RESERVE_COMPLETION_TOKENS=4096
MAX_OUTPUT_TOKENS=2048

# ── CORS Origins & Connections ───────────────────────────────────────────────
NODE_API_ORIGIN=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development

# ── Internal service auth ──────────────────────────────────────────────────
# Shared secret with node-api (sent as X-Internal-Key header).
# Leave empty for plain local dev; SET IT in docker/production.
INTERNAL_API_KEY=

